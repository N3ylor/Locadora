# Copie para .env (cp .env.example .env) e ajuste. NUNCA publique o .env.
ADMIN_USERNAME=admin
# Mínimo de 8 caracteres. O valor abaixo é recusado de propósito.
ADMIN_PASSWORD=defina-uma-senha-forte-aqui

# Porta publicada no host (o contêiner sempre usa 8080).
HOST_PORT=8080

# true somente se houver HTTPS na frente da aplicação.
COOKIE_SECURE=false

# Fuso horário usado para o "hoje" das locações e das multas por atraso.
TIMEZONE=America/Sao_Paulo
